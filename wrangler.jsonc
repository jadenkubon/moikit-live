{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moikit-live",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },

  // Owner "new order" alert email, sent from the Stripe webhook via Cloudflare
  // Email Routing (see src/lib/notify.ts → sendOwnerAlert). The binding is
  // restricted to the owner's VERIFIED Email Routing destination.
  "send_email": [
    // Owner alert → restricted to the owner's verified Email Routing destination.
    { "name": "OWNER_EMAILER", "destination_address": "moikit.fi@proton.me" },
    // Customer confirmation → unrestricted; sends to any buyer via Cloudflare
    // Email Sending (moikit.fi is onboarded, DKIM cf-bounce + DMARC in place).
    { "name": "CUSTOMER_EMAILER" }
  ],
  "vars": {
    "OWNER_EMAIL": "moikit.fi@proton.me",
    "ORDER_FROM": "MoiKit <orders@moikit.fi>"
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "566e67c30a944a638d0f2693f464eab2",
      // Dev-only: wrangler/astro dev refuse to boot without a local Postgres
      // string to emulate Hyperdrive. Ignored by the deployed Worker (which uses
      // the real Hyperdrive `id`). Nothing local actually writes here — the
      // webhook is exercised via Stripe against production — so a placeholder is
      // enough to unblock `npm run dev`.
      "localConnectionString": "postgres://dev:dev@localhost:5432/moikit_dev"
    }
  ]
}
