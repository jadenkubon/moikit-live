---
import { KITS } from "../data/kits";
import { LEGAL_LINKS } from "../lib/legal";
import { t } from "../lib/i18n";
---

<footer class="bg-ink text-cream">
  <div class="mx-auto max-w-[1180px] px-7 pt-16 pb-10">
    <div class="grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-[11px]">
          <span
            class="h-9 w-9 shrink-0 bg-[url('/uploads/moikit-logo-192.webp')] bg-[length:150%] bg-[position:center_24%] bg-no-repeat"
          ></span>
          <span class="font-display text-xl font-bold">MoiKit</span>
        </div>
        <p data-i18n="footer.blurb" class="mt-4 max-w-[280px] text-[14.5px] leading-relaxed text-cream/65">
          {t("footer.blurb")}
        </p>
        <p data-i18n="footer.place" class="mt-[18px] font-mono text-xs tracking-[.04em] text-cream/50">
          {t("footer.place")}
        </p>
      </div>
      <div>
        <div class="mb-4 font-mono text-[11px] uppercase tracking-[.2em] text-amber" data-i18n="footer.kits">{t("footer.kits")}</div>
        {KITS.map((k) => (
          <a href={`/kits/${k.slug}/`} class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">
            {k.name}
          </a>
        ))}
      </div>
      <div>
        <div class="mb-4 font-mono text-[11px] uppercase tracking-[.2em] text-amber" data-i18n="footer.company">{t("footer.company")}</div>
        <a href="/#faq" data-i18n="nav.faq" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">{t("nav.faq")}</a>
        <a href={LEGAL_LINKS.terms} data-i18n="footer.terms" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">{t("footer.terms")}</a>
        <a href={LEGAL_LINKS.withdrawal} data-i18n="footer.withdrawal" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">{t("footer.withdrawal")}</a>
        <a href={LEGAL_LINKS.privacy} data-i18n="footer.privacy" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">{t("footer.privacy")}</a>
      </div>
      <div>
        <div class="mb-4 font-mono text-[11px] uppercase tracking-[.2em] text-amber" data-i18n="footer.contact">{t("footer.contact")}</div>
        <a href="https://instagram.com/moi.kit_fi" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">@moi.kit_fi</a>
        <a href="mailto:moi@moikit.fi" class="mb-[11px] block text-[14.5px] text-cream/80 no-underline">moi@moikit.fi</a>
      </div>
    </div>
    <div class="mt-11 mb-[22px] h-px bg-cream/10"></div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="text-[13px] text-cream/50">© 2026 MoiKit</span>
      <div class="flex flex-wrap gap-[22px]">
        <a href={LEGAL_LINKS.terms} data-i18n="footer.termsShort" class="text-[13px] text-cream/50 no-underline">{t("footer.termsShort")}</a>
        <a href={LEGAL_LINKS.withdrawal} data-i18n="footer.returnsShort" class="text-[13px] text-cream/50 no-underline">{t("footer.returnsShort")}</a>
        <a href={LEGAL_LINKS.privacy} data-i18n="footer.privacyShort" class="text-[13px] text-cream/50 no-underline">{t("footer.privacyShort")}</a>
      </div>
    </div>
  </div>
</footer>
