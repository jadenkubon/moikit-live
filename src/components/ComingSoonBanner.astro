---
const formUrl = "https://tally.so/r/WOBxka";
---

<div
  class="sticky top-0 z-60 flex h-[var(--banner-h)] items-center border-b border-ink/15 bg-amber text-ink"
  role="region"
  aria-label="Site status"
>
  <div
    class="mx-auto flex w-full max-w-[1180px] flex-wrap items-center justify-center gap-x-3 gap-y-0.5 px-4 text-center sm:px-7"
  >
    <span
      class="shrink-0 rounded-full bg-teal px-[11px] py-1 font-mono text-[11px] font-bold uppercase tracking-[.18em] text-cream"
      >Coming soon</span
    >
    <p class="order-3 w-full text-[13px] font-medium leading-[1.35] sm:order-none sm:w-auto sm:text-[14.5px]">
      MoiKit isn&rsquo;t taking orders yet &mdash; kits ship later this year.
    </p>
    <a
      href={formUrl}
      target="_blank"
      rel="noopener"
      class="shrink-0 border-b-2 border-ink/45 pb-px font-display text-[14px] font-semibold text-ink no-underline transition-colors hover:border-ink sm:text-[14.5px]"
    >
      Join the early list <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>
