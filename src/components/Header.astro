---
import { t } from "../lib/i18n";

const nav = [
  { href: "/#kits", key: "nav.kits" as const },
  { href: "/#how", key: "nav.how" as const },
  { href: "/#faq", key: "nav.faq" as const },
];
---

<div class="sticky top-0 z-50">
  <div class="flex h-[34px] items-center justify-center bg-teal text-cream">
    <span
      id="trust-rotator"
      class="font-mono text-[11.5px] uppercase tracking-[.18em] whitespace-nowrap animate-trust"
    >◆&ensp;{t("trust.delivery")}&ensp;◆</span>
  </div>

  <header class="border-b border-sand bg-cream/85 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-5 px-7 py-3.5">
      <a href="/" class="flex items-center gap-[11px] text-ink no-underline">
        <span
          class="h-[38px] w-[38px] shrink-0 bg-[url('/uploads/moikit-logo-192.webp')] bg-[length:150%] bg-[position:center_24%] bg-no-repeat"
        ></span>
        <span class="font-display text-[21px] font-bold tracking-[.01em]">MoiKit</span>
      </a>

      <nav class="flex items-center gap-7">
        {nav.map((n) => (
          <a
            href={n.href}
            data-i18n={n.key}
            class="hidden text-[15px] font-medium text-body-2 no-underline md:block"
          >
            {t(n.key)}
          </a>
        ))}
        <a
          href="/#kits"
          data-i18n="nav.shop"
          class="rounded-full bg-teal px-5 py-[11px] font-display text-[14.5px] font-semibold text-cream no-underline transition-opacity hover:opacity-90"
        >{t("nav.shop")}</a>
      </nav>
    </div>
  </header>
</div>

<script>
  import { COPY } from "../lib/i18n";

  // The strapline is script-driven and carries ◆ decorations, so it is NOT
  // marked data-i18n (the generic swap would strip the decoration). It instead
  // re-reads the dictionary whenever LangToggle announces a change.
  const el = document.getElementById("trust-rotator");
  const KEYS = ["trust.delivery", "trust.ready", "trust.local"] as const;

  const lang = () => (document.documentElement.lang === "fi" ? "fi" : "en");
  const phrase = (i: number) => COPY[KEYS[i % KEYS.length]][lang()];

  let i = 0;
  const render = () => {
    if (el) el.textContent = `◆ ${phrase(i)} ◆`;
  };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !reduce) {
    setInterval(() => {
      i++;
      render();
      el.style.animation = "none";
      void el.offsetWidth;
      el.style.animation = "";
    }, 2600);
  }

  // Swap the currently shown phrase immediately on a language change, rather
  // than leaving the old language up until the next 2.6s tick.
  document.addEventListener("moikit:langchange", render);
</script>
